{
  "name": "stockroom-workspace",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "build": "npm run build -w frontend",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "web": "npm run dev -w frontend",
    "test:postgres": "bash tests/native-postgres.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jose": "^6.2.17",
    "multer": "^2.1.1",
    "pdfkit": "^0.17.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=22"
  }
}
